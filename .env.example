NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use an isolated database for development. Never point migration commands at
# an unverified production or legacy database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/petalcraft"

# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# Used by the seed command to create the first administrator.
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_NAME=""

# Cloud media configuration. Local uploads are not a production provider.
STORAGE_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# Official WhatsApp Cloud API (server-only except NEXT_PUBLIC_APP_URL above).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_DEFAULT_COUNTRY_CODE="977"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_TEMPLATE_ORDER_RECEIVED="petalcraft_order_received"
WHATSAPP_TEMPLATE_STATUS_CONTACTED="petalcraft_order_contacted"
WHATSAPP_TEMPLATE_STATUS_CONFIRMED="petalcraft_order_confirmed"
WHATSAPP_TEMPLATE_STATUS_IN_PROGRESS="petalcraft_order_in_progress"
WHATSAPP_TEMPLATE_STATUS_COMPLETED="petalcraft_order_completed"
WHATSAPP_TEMPLATE_STATUS_CANCELLED="petalcraft_order_cancelled"

# Official Instagram API. All values below are server-only.
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_API_VERSION="v26.0"
INSTAGRAM_APP_SECRET=""
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=""
