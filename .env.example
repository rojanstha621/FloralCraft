NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Use an isolated database for development. Never point migration commands at
# an unverified production or legacy database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/petalcraft"

# Generate with: openssl rand -hex 32
AUTH_SECRET=""

# Used by the seed command to create the first administrator.
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_NAME=""

# Cloud media configuration. Local uploads are not a production provider.
STORAGE_PROVIDER="supabase"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"
