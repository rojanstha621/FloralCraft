datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  OWNER
  ADMIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum OrderRequestStatus {
  NEW
  CONTACTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([active])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
}

model ProductType {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active, sortOrder])
}

model Product {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  tagline              String?
  description          String
  price                Decimal               @db.Decimal(12, 2)
  compareAtPrice       Decimal?              @db.Decimal(12, 2)
  available            Boolean               @default(true)
  featured             Boolean               @default(false)
  customizable         Boolean               @default(false)
  customizationSummary String?
  dimensions           String?
  materials            String?
  preparationDays      Int?
  archivedAt           DateTime?
  categoryId           String
  productTypeId        String
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  productType          ProductType           @relation(fields: [productTypeId], references: [id], onDelete: Restrict)
  images               ProductImage[]
  customizationOptions CustomizationOption[]
  reviews              Review[]
  orderRequestItems    OrderRequestItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([categoryId, available])
  @@index([productTypeId, available])
  @@index([featured, available])
  @@index([archivedAt])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  provider   String?
  storageKey String?
  alt        String?
  sortOrder  Int      @default(0)
  primary    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, sortOrder])
  @@index([productId, primary])
  @@index([provider, storageKey])
}

model CustomizationOption {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key             String
  label           String
  description     String?
  inputKind       String
  required        Boolean  @default(false)
  choices         Json?
  priceAdjustment Decimal  @default(0) @db.Decimal(12, 2)
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, key])
  @@index([productId, active, sortOrder])
}

model Review {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewerName  String
  reviewerEmail String?
  rating        Int
  body          String
  imageUrl      String?
  imageProvider String?
  imageKey      String?
  status        ReviewStatus @default(PENDING)
  verified      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

model OrderRequest {
  id               String             @id @default(cuid())
  requestNumber    String             @unique
  customerName     String
  customerPhone    String
  customerEmail    String?
  preferredChannel String
  status           OrderRequestStatus @default(NEW)
  desiredDate      DateTime?
  notes            String?
  adminNotes       String?
  contactedAt      DateTime?
  items            OrderRequestItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
}

model OrderRequestItem {
  id                  String       @id @default(cuid())
  orderRequestId      String
  orderRequest        OrderRequest @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameSnapshot String
  unitPriceSnapshot   Decimal?     @db.Decimal(12, 2)
  quantity            Int          @default(1)
  customization       Json?
  notes               String?
  createdAt           DateTime     @default(now())

  @@index([orderRequestId])
  @@index([productId])
}

model BusinessSettings {
  id                      String   @id @default("default")
  businessName            String
  tagline                 String?
  email                   String?
  phone                   String?
  whatsappNumber          String?
  address                 String?
  currencyCode            String   @default("NPR")
  currencySymbol          String   @default("Rs. ")
  openingHours            Json?
  socialLinks             Json?
  orderingMethods         Json
  whatsappMessageTemplate String?
  homepage                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}
